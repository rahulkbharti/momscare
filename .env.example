GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DOCUMENT_API_TOKEN=change-this-to-any-secret-token
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/momcare?appName=Cluster0

# Full absolute path to coral binary (leave blank to use system PATH)
# Windows example: CORAL_CLI_PATH=C:\Users\YourName\AppData\Local\Programs\coral\coral.exe
# Mac/Linux example: CORAL_CLI_PATH=/usr/local/bin/coral
CORAL_CLI_PATH=

# IMPORTANT: Absolute path to the data/ folder in this project
# Windows example: CORAL_DATA_PATH=C:\Users\YourName\projects\mom-care-api\data
# Mac/Linux example: CORAL_DATA_PATH=/home/yourname/projects/mom-care-api/data
CORAL_DATA_PATH=
